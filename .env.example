# NewsTrader API keys
# --------------------------------------------------------------------
# Easiest way: start the app and paste your keys into Settings -> API Keys.
# The app writes them into this file (.env) for you.
# If you edit by hand: copy this file to ".env" (same folder) and fill in values.
# Never share your .env file or commit it to GitHub.

# Alpaca PAPER trading keys (https://app.alpaca.markets -> switch to Paper -> API Keys)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Alpaca LIVE keys - leave EMPTY unless you deliberately want real-money trading.
# Live trading also requires typing a confirmation in the app every time it starts.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Optional: Anthropic (Claude) API key - only needed if you switch Settings -> AI engine to Claude.
# The default local machine-learning engine is free and needs no key. (https://platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional: Discord webhook URL for alerts (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Optional: X (Twitter) API bearer token - only if you buy X API access
X_BEARER_TOKEN=
