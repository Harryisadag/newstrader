# Windows batch files are stored with CRLF line endings as-is (works from git clone AND ZIP download)
*.bat -text
*.cmd -text
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.ico binary
# Mac launchers must keep LF line endings (and are committed as executable)
*.command text eol=lf
*.sh text eol=lf
*.icns binary
*.onnx binary
